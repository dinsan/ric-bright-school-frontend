# Copy to .env.local for local development: cp .env.example .env.local
# Both values default to http://localhost:8000, so you only need this file if your API runs elsewhere.

# Base URL the browser uses to reach the API. Inlined into the client bundle at build time,
# so restart `npm run dev` (or rebuild) after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL server-side rendering uses. Optional; falls back to NEXT_PUBLIC_API_URL.
# API_URL=http://localhost:8000
